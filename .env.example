# ===== 环境变量模板 =====
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中排除，切勿提交。

# ---- 应用 ----
APP_NAME=SeaSight
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seasight
POSTGRES_USER=seasight
POSTGRES_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- MQTT (EMQX) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=seasight-backend
MQTT_TOPIC_PREFIX=marine

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_EVENTS=events
MINIO_SECURE=false

# ---- 流媒体 (go2rtc) ----
STREAM_BASE_URL=http://localhost:1984

# ---- AI 推理服务 ----
AI_SERVICE_URL=http://localhost:8081
AI_MODEL_VERSION=det_v0.1.0

# ---- Agent 可选规划模型（OpenAI-compatible；默认关闭） ----
AGENT_MODEL_ADAPTER_ENABLED=false
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_ADAPTER_TIMEOUT_MS=5000
AGENT_MODEL_ADAPTER_MAX_STEPS=10
AGENT_MODEL_MAX_OUTPUT_TOKENS=1024

# ---- Agent 运行策略（演示 / 验收可用；默认与生产策略一致） ----
# AGENT_REQUIRE_APPROVAL_FOR_WRITE=true 时，WRITE 风险工具（如
# task.create_or_merge）必须先取得人工审批才能执行。演示录屏要拍
# 「智能体不私自建单、人批准后才动手」这段镜头时打开它；
# 也可以直接用 `make demo-approval-up`（走 docker-compose.demo.yml 覆盖层，
# 不改本文件、不改任何业务代码）。
AGENT_REQUIRE_APPROVAL_FOR_WRITE=false
# true 时 run/step/approval 落库，服务重启后仍可只读回放；数据库不可用时自动回退内存。
AGENT_PERSISTENT_REPOSITORY_ENABLED=false

# ---- 对话助手（默认启用规则兜底；配齐模型三要素才走真实 LLM） ----
ASSISTANT_ENABLED=true
ASSISTANT_MODEL_BASE_URL=
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_NAME=
ASSISTANT_MODEL_TIMEOUT_MS=8000
ASSISTANT_MODEL_MAX_TOOL_ROUNDS=4
ASSISTANT_MODEL_MAX_OUTPUT_TOKENS=1024
ASSISTANT_HISTORY_LIMIT=12
ASSISTANT_MAX_IMAGE_MB=8

# ---- CORS（前端来源，逗号分隔） ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 派单引擎参数 ----
DISPATCH_MIN_BATTERY=30
DISPATCH_MAX_BIN_USAGE=0.8
DISPATCH_ACK_TIMEOUT_SECONDS=15
DISPATCH_MERGE_WINDOW_MINUTES=10

# ---- Nexent MCP（独立进程；推荐配置在 integrations/nexent/.env） ----
# 后端环境不读取以下变量。接入 Nexent 时复制 integrations/nexent/.env.example，
# 不要把真实 SEASIGHT_API_TOKEN 提交到仓库。
# SEASIGHT_API_BASE_URL=http://127.0.0.1:8000/api/v1
# SEASIGHT_API_TOKEN=
# SEASIGHT_MCP_ALLOW_WRITES=false
# SEASIGHT_MCP_TIMEOUT_SECONDS=30
# SEASIGHT_MCP_TRANSPORT=stdio
