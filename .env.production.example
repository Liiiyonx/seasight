# Oceanus production environment template.
# Copy to .env.production, replace every CHANGE_ME value, then keep it off git.

# ---- Application ----
APP_NAME=Oceanus
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_64_RANDOM_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://seasight.example.cn

# ---- Public entry point ----
# The frontend container binds only to loopback. Host Nginx or Caddy should
# terminate TLS and proxy to this address.
HTTP_PORT=8080

# ---- PostgreSQL ----
POSTGRES_DB=seasight
POSTGRES_USER=seasight
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_CONNECT_TIMEOUT_SECONDS=3

# ---- Redis ----
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ---- MQTT / EMQX ----
MQTT_BACKEND_USERNAME=backend_service
MQTT_BACKEND_PASSWORD=CHANGE_ME_STRONG_BACKEND_MQTT_PASSWORD
MQTT_EDGE_USERNAME=edge_device
MQTT_EDGE_PASSWORD=CHANGE_ME_STRONG_EDGE_MQTT_PASSWORD
MQTT_VIEWER_USERNAME=dashboard_viewer
MQTT_VIEWER_PASSWORD=CHANGE_ME_STRONG_VIEWER_MQTT_PASSWORD
MQTT_ROBOT_USERNAME=robot_device
MQTT_ROBOT_PASSWORD=CHANGE_ME_STRONG_ROBOT_MQTT_PASSWORD
MQTT_CLIENT_ID=seasight-backend

# ---- 路演：设备经 WSS 连云端（2026-10-05 新增）----
# 云端 EMQX 的 1883 绑 127.0.0.1（正确设计），公网只开 80/443，
# 所以设备必须走 MQTT-over-WebSocket：443 /mqtt -> nginx -> emqx:8083。
# 设备侧（树莓派 bridge）对应设置：
#   ARM_MQTT_HOST=<本项目公网域名>
#   ARM_MQTT_PORT=443
#   ARM_MQTT_TRANSPORT=ws
#   ARM_MQTT_PATH=/mqtt            # 须与 nginx location 完全一致
#   ARM_MQTT_USERNAME=robot_device
#   ARM_MQTT_PASSWORD=<MQTT_ROBOT_PASSWORD 的值>
#
# EMQX 的 WS 监听端口（仅绑回环，供 nginx 反代）：
MQTT_WS_PORT=8083
# 注意：CORS_ORIGINS 已在文件开头定义过（line 10），此处不要重复。
# 路演要求：安全组放行 443，且该值与实际域名一致。
MQTT_TOPIC_PREFIX=marine
# Expose 1883 only on the device/VPN interface. Change to 0.0.0.0 only after
# the host firewall limits access to trusted edge networks.
MQTT_BIND_ADDR=127.0.0.1
MQTT_DASHBOARD_USER=admin
MQTT_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_EMQX_DASHBOARD_PASSWORD
MQTT_DASHBOARD_PORT=18083

# ---- MinIO (private object storage) ----
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET_KEY
MINIO_BUCKET_EVENTS=events
MINIO_SECURE=false

# ---- Streaming ----
STREAM_BASE_URL=http://go2rtc:1984
# Empty means the API returns /stream/...; set this to the public subpath
# (for example /seasight) when the app is mounted below the domain root.
STREAM_PUBLIC_BASE_URL=

# ---- Frontend build-time map proxy ----
# Vite embeds this value when the frontend image is built. Set it to the
# browser-facing Tencent map key proxy URL allowed by your deployment.
VITE_TMAP_PROXY_URL=
# Root-domain deployments use /. Shared-host deployments can use a subpath,
# for example /seasight/, while the outer Nginx strips the same prefix.
VITE_BASE_PATH=/
# ArmPiFPV 树莓派自带仿真台 / 上位机跳转地址。留空时仿真页显示「待接入真机」。
VITE_ARM_CONSOLE_URL=
VITE_ARM_CONSOLE_LABEL=ArmPiFPV 仿真台

# ---- AI service ----
AI_SERVICE_URL=http://ai-service:8081
AI_MODEL_VERSION=det_v0.1.0

# ---- Nexent MCP bridge ----
# Dedicated least-privilege account used by the MCP container. The bridge logs
# in through /api/v1/auth/login and refreshes its short-lived access token.
SEASIGHT_API_USERNAME=CHANGE_ME_NEXENT_API_USER
SEASIGHT_API_PASSWORD=CHANGE_ME_NEXENT_API_PASSWORD
# Optional static override. Leave blank when username/password auto-refresh is
# used. If set, this token takes precedence and is never refreshed.
SEASIGHT_API_TOKEN=
SEASIGHT_API_REFRESH_SKEW_SECONDS=300
# Read-only tools are registered by default. Set true only for workflows that
# deliberately create assets, review ontology candidates, or control Agent runs.
SEASIGHT_MCP_ALLOW_WRITES=false
# This is a separate inbound secret sent by Nexent as:
#   Authorization: Bearer <SEASIGHT_MCP_SERVER_TOKEN>
# Use at least 32 random characters. Do not reuse SEASIGHT_API_TOKEN.
SEASIGHT_MCP_SERVER_TOKEN=CHANGE_ME_NEXENT_MCP_INBOUND_TOKEN_AT_LEAST_32_CHARS
# Nexent registration URL. Keep the port private unless a firewall/VPN protects it.
NEXENT_MCP_BIND_ADDR=127.0.0.1
NEXENT_MCP_PORT=8100
SEASIGHT_MCP_PUBLIC_URL=http://127.0.0.1:8100/mcp

# ---- Agent optional planner (leave disabled unless configured) ----
AGENT_MODEL_ADAPTER_ENABLED=false
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_ADAPTER_TIMEOUT_MS=5000
AGENT_MODEL_ADAPTER_MAX_STEPS=10
AGENT_MODEL_MAX_OUTPUT_TOKENS=1024
AGENT_PERSISTENT_REPOSITORY_ENABLED=true
AGENT_REQUIRE_APPROVAL_FOR_WRITE=true

# ---- Dispatch ----
DISPATCH_MIN_BATTERY=30
DISPATCH_MAX_BIN_USAGE=0.8
DISPATCH_ACK_TIMEOUT_SECONDS=15
DISPATCH_MERGE_WINDOW_MINUTES=10
