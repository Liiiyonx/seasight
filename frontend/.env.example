# 前端构建期环境变量（Vite）
#
# 复制为 .env.local 后按需修改。**注意：这些是构建期注入的**，
# 改完必须重新 `npm run build`，否则不生效 —— 开发时 vite 会自动热更新，
# 但生产镜像里的值是打包那一刻定下的。
#
# ★ 本文件不得提交真实密钥。腾讯地图密钥走 Nginx 代理（见
#   docs/deployment.md），前端源码里搜不到任何地图密钥。

# ---------- 后端地址 ----------
# 留空则用同源相对路径（推荐：生产环境由 Nginx 反代，避免 CORS 与混合内容问题）
VITE_BACKEND_URL=
VITE_BACKEND_WS_URL=

# ---------- 机械臂执行端（ArmSimConsole）----------
# 跳转目标，三档共用这一个键，组件按协议自动判断接入方式：
#   http://<IP>:4080   NoMachine Web Player（社区版不开放，需企业版）
#   http://<IP>:<port>  树莓派上的原生Web 上位机（若厂商提供）
#   nx://<IP>          唤起演示机本地的 NoMachine 客户端
#
# 实测结论（2026-10-05，树莓派 ArmPiFPV）：
#   22/  开  SSH
#   4000  开  NoMachine NX 二进制协议
#   8080  开  ROS Image Topic List（不是 Web 上位机）
#   4080  关  ← NoMachine 社区版不开 Web Player
#  ⇒ 社区版只能用 nx://，且**演示机必须预装 NoMachine 客户端**。
#  详见 docs/competitions/arm-hardware-probe-2026-10-05.md
VITE_ARM_CONSOLE_URL=
# 面板上显示的名称
VITE_ARM_CONSOLE_LABEL=ArmPiFPV 仿真台
# 当前执行后端，必须与 edge/arm_bridge/config.yaml 的 driver.backend 一致：
#   simulated        仿真执行器（不驱动硬件，验证平台协议闭环）
#   http             HTTP 转发
#   ros_arm_control  ★真机推荐：复用厂商 ros_control，与厂商程序共存，
#                              读 joint_states 拿真实关节角
#   hiwonder_bus_servo 真机备选：直连串口。**需先停掉厂商节点**
#                              （它占着 /dev/ttyS0），与厂商 GUI 互斥
VITE_ARM_DRIVER_BACKEND=simulated

# ---------- 登录页演示账号面板 ----------
# ★ 生产构建**留空** —— 面板不渲染，产物里不会有任何明文口令。
#   硬编码口令会同时泄漏到：打包产物（→ 公开仓库）、登录页截图
#   （→ 软著材料 / 答辩 PPT）、aria-label（读屏会念给全场听）。
#
# 需要现场演示时，构建一份专用产物：
#   VITE_DEMO_ACCOUNTS='[{"username":"admin","password":"xxx","label":"系统管理员","short":"管","tone":"blue"}]' \
#     npm run build
#
# tone可选：blue / green / orange / gray
# 账号须与后端 02_seed.sql 里的种子用户一致，否则点了填不进去。
VITE_DEMO_ACCOUNTS=

# ---------- 登录页演示账号面板 ----------
# ★ 生产构建**留空** —— 面板不渲染，产物里不会有任何明文口令。
#   硬编码口令会同时泄漏到：打包产物（→ 公开仓库）、登录页截图
#   （→ 软著材料 / 答辩 PPT）、aria-label（读屏会念给全场听）。
#
# 需要现场演示时，构建一份专用产物：
#   VITE_DEMO_ACCOUNTS='[{"username":"admin","password":"xxx","label":"系统管理员","short":"管","tone":"blue"}]' #     npm run build
#
# tone可选：blue / green / orange / gray
# 账号须与后端 02_seed.sql 里的种子用户一致，否则点了填不进去。
VITE_DEMO_ACCOUNTS=
