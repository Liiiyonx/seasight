# Oceanus API reachable from the Nexent process.
SEASIGHT_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Long-running deployments should use a dedicated least-privilege account. The
# MCP server logs in through POST /api/v1/auth/login, caches the access token,
# and refreshes it before expiry.
#   viewer   -> read-only knowledge and operational queries
#   operator -> register assets, create decisions, start Agent runs
#   admin/approver -> review/publish ontology and decide approvals
SEASIGHT_API_USERNAME=
SEASIGHT_API_PASSWORD=

# Optional static override for local smoke tests or an externally managed token.
# When set, this token takes precedence over username/password auto-refresh.
# Use a signed access token issued by POST /api/v1/auth/login.
#   viewer  -> read-only knowledge and operational queries
#   operator -> register assets, create decisions, start Agent runs
#   admin/approver -> review/publish ontology and decide approvals
SEASIGHT_API_TOKEN=
SEASIGHT_API_REFRESH_SKEW_SECONDS=300

# Read-only by default. Enabling writes registers registration, review,
# publication, decision, Agent run, cancellation and approval tools.
SEASIGHT_MCP_ALLOW_WRITES=false

SEASIGHT_MCP_TIMEOUT_SECONDS=30
SEASIGHT_MCP_TRANSPORT=stdio

# HTTP transports refuse to start without this separate inbound token.
# Nexent sends it as: Authorization: Bearer <SEASIGHT_MCP_SERVER_TOKEN>
SEASIGHT_MCP_SERVER_TOKEN=
SEASIGHT_MCP_HOST=127.0.0.1
SEASIGHT_MCP_PORT=8100
# Full client-visible /mcp or /sse URL. Set the HTTPS public URL in production.
SEASIGHT_MCP_PUBLIC_URL=http://127.0.0.1:8100/mcp
